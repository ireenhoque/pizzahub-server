# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster-host>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST.mongodb.net/?retryWrites=true&w=majority
DB_NAME=pizzahub

# Better Auth JWT verification
# JWKS endpoint of your Better Auth server (JWT plugin must be enabled),
# e.g. https://auth.yourdomain.com/api/auth/jwks
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
# Expected iss claim — your Better Auth server base URL
JWT_ISSUER=http://localhost:3000
# Expected aud claim — whatever Better Auth sets (defaults to the base URL)
JWT_AUDIENCE=http://localhost:3000
