# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster-host>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST.mongodb.net/?retryWrites=true&w=majority
DB_NAME=pizzahub

# Better Auth JWT verification
# JWKS endpoint of your Better Auth server (JWT plugin must be enabled),
# e.g. https://auth.yourdomain.com/api/auth/jwks
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
# Expected iss claim — your Better Auth server base URL
JWT_ISSUER=http://localhost:3000
# Expected aud claim — whatever Better Auth sets (defaults to the base URL)
JWT_AUDIENCE=http://localhost:3000

# ImgBB image upload (get a key at https://api.imgbb.com)
# Used ONLY server-side; the key is never sent to the browser.
IMGBB_API_KEY=YOUR_IMGBB_API_KEY_HERE

# Stripe — vendor Premium subscriptions (server-only; never expose to browser)
# Use test-mode keys/secrets for local development. Do not create another
# Stripe product or price: reuse the existing Sandbox Premium recurring Price
# ($499 USD/month).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# Frontend redirect URLs (must be valid URLs). For local testing with the
# existing pizzahub-client (Next.js on :3000), vendor subscription checkout
# returns to the existing vendor subscription page:
#   STRIPE_SUCCESS_URL=http://localhost:3000/vendor/subscription?checkout=success
#   STRIPE_CANCEL_URL=http://localhost:3000/vendor/subscription?checkout=cancel
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
